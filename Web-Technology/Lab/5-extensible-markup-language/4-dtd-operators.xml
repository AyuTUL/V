<?xml version="1.0" encoding="UTF-8"?>
<!-- Lab 4: Minimal DTD with +, *, ?, comma, |, () operators -->
<!DOCTYPE root [
    <!ELEMENT root (item+)>
    <!ELEMENT item (title, (desc | note)?, tag*)>
    <!ELEMENT title (#PCDATA)>
    <!ELEMENT desc (#PCDATA)>
    <!ELEMENT note (#PCDATA)>
    <!ELEMENT tag (#PCDATA)>
]>

<root>
    <item>
        <title>Spurs</title>
        <desc>Cheeks</desc>
        <tag>Richarlison</tag>
        <tag>Paulinha</tag>
    </item>
    <item>
        <title>MUFC</title>
        <note>Fernandes</note>
    </item>
</root>