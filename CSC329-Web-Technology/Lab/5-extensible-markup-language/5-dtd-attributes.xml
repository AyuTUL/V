<?xml version="1.0" encoding="UTF-8"?>
<!-- Lab 5: DTD Attribute Values: #REQUIRED, #IMPLIED, #FIXED -->
<!DOCTYPE root [
    <!ELEMENT root (item+)>
    <!ELEMENT item (#PCDATA)>
    <!ATTLIST item
        id ID #REQUIRED
        name CDATA #IMPLIED
        type (europe|asia|america) #FIXED "europe"
        status CDATA #REQUIRED
        description CDATA #IMPLIED
  >
]>

<root>
    <item id="1" name="mufc" status="active" type="europe">Mbeumo</item>
    <item id="2" status="inactive" type="europe">Valverde</item>
    <item id="3" name="mls" description="mickey mouse" status="active" type="america">Griezmann</item>
</root>