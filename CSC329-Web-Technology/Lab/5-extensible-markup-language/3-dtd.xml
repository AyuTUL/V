<?xml version="1.0" encoding="UTF-8"?>
<!-- Lab 3: Write internal and external DTD to describe "mail" as a root element and "to", "from",
and "subject", and "message" as child elements. -->
<!DOCTYPE mail [
    <!ELEMENT mail (to, from, subject, message)>
    <!ELEMENT to (#PCDATA)>
    <!ELEMENT from (#PCDATA)>
    <!ELEMENT subject (#PCDATA)>
    <!ELEMENT message (#PCDATA)>
]>
<mail>
    <to>Harry Kane</to>
    <from>Heung-Min Son</from>
    <subject>Europa League 24/25</subject>
    <message>Harry, we also won a trophy.</message>
</mail>
